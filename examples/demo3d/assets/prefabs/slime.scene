# A slime: a squashy sphere with eyes that hops toward the player (SlimeHop drives the squash and the jumps).
node Slime {
  Transform3D { }
  SlimeHop { }
  node Body {
    Transform3D { position = [0, 0.45, 0]  scale = [0.9, 0.9, 0.9] }
    MeshRenderer3D { mesh = "sphere"  color = [90, 220, 120]  emissive = [10, 50, 20]  rim = 0.5  shadow = true  shadow_size = 0.6 }
    node EyeL {
      Transform3D { position = [-0.17, 0.12, 0.42]  scale = [0.16, 0.2, 0.1] }
      MeshRenderer3D { mesh = "sphere"  color = [20, 20, 30] }
    }
    node EyeR {
      Transform3D { position = [0.17, 0.12, 0.42]  scale = [0.16, 0.2, 0.1] }
      MeshRenderer3D { mesh = "sphere"  color = [20, 20, 30] }
    }
    node Shine {
      Transform3D { position = [0.16, 0.3, 0.32]  scale = [0.12, 0.08, 0.06] }
      MeshRenderer3D { mesh = "sphere"  color = [255, 255, 255]  unlit = true }
    }
  }
  node Dust {
    Particles3D { preset = "dust"  burst = 0  spread = 85  speed = 1.6 }
  }
}
