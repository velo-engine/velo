# Velo 3D demo: run around a twilight arena collecting orbs. The hero is an FBX character (models/than_dieu_run.fbx,
# a Mixamo "Fast Run"); the other characters are built from primitives in prefabs/.
node Main {
  Environment3D { sky = [150, 165, 220]  ground = [95, 85, 90]  ambient = 0.85  fog_color = [110, 116, 160]  fog_density = 0.028 }
  node Sun {
    DirectionalLight3D { direction = [-0.5, -1, -0.35]  color = [255, 226, 200]  intensity = 1.05 }
  }
  node Camera {
    Transform3D { position = [0, 4, -8] }
    Camera3D { fov = 55 }
    FollowCamera { target = "World/Hero"  distance = 7.5  height = 3.2  yaw = 0 }
  }
  node World {
    node Ground {
      Transform3D { scale = [240, 1, 240] }
      MeshRenderer3D { mesh = "grid"  grid_cells = 120  color = [92, 150, 92]  pattern = "noise" }
    }
    node Plaza {
      Transform3D { position = [0, 0.02, 0]  scale = [11, 1, 11] }
      MeshRenderer3D { mesh = "grid"  grid_cells = 6  color = [170, 160, 150]  pattern = "tiles" }
    }
    node Pond {
      Transform3D { position = [-12, 0.04, 9]  scale = [7, 1, 5] }
      MeshRenderer3D { mesh = "plane"  color = [70, 140, 220, 190]  blend = "alpha"  pattern = "noise"  uv_scale = [2, 2]  uv_scroll = [0.03, 0.02]  rim = 0.3 }
    }
    node Portal {
      Transform3D { position = [0, 0, 14] }
      node Ring {
        Transform3D { position = [0, 2, 0]  rotation = [90, 0, 0]  scale = [2.2, 2.2, 2.2] }
        MeshRenderer3D { mesh = "torus"  color = [210, 140, 255]  emissive = [120, 50, 200]  rim = 1 }
      }
      node Swirl {
        Transform3D { position = [0, 2, 0]  rotation = [90, 0, 0]  scale = [2.1, 2.1, 2.1] }
        Spin3D { speed = [0, 120, 0] }
        MeshRenderer3D { mesh = "disc"  color = [200, 110, 255, 140]  blend = "additive"  unlit = true  pattern = "stripes"  uv_scale = [2, 2]  uv_scroll = [0.5, 0] }
      }
      node Sparks {
        Transform3D { position = [0, 2, 0]  rotation = [90, 0, 0] }
        Particles3D { preset = "portal" }
      }
      node Base {
        Transform3D { position = [0, 0.1, 0]  scale = [4, 0.2, 1.4] }
        MeshRenderer3D { mesh = "cube"  color = [100, 95, 110]  pattern = "tiles" }
      }
      PointLight3D { color = [200, 120, 255]  intensity = 2  range = 8 }
    }
    node HealSpring {
      Transform3D { position = [10, 0.05, -8] }
      node Pad {
        Transform3D { scale = [2.4, 0.1, 2.4] }
        MeshRenderer3D { mesh = "cylinder"  color = [120, 230, 150]  emissive = [20, 90, 40]  rim = 0.6 }
      }
      Particles3D { preset = "heal" }
      HealZone { radius = 1.4 }
      PointLight3D { color = [120, 255, 150]  intensity = 1.2  range = 5 }
    }
    node Torch1 from @asset("d3a10006") { Transform3D { position = [5.5, 0, 5.5] } }
    node Torch2 from @asset("d3a10006") { Transform3D { position = [-5.5, 0, 5.5] } }
    node Torch3 from @asset("d3a10006") { Transform3D { position = [5.5, 0, -5.5] } }
    node Torch4 from @asset("d3a10006") { Transform3D { position = [-5.5, 0, -5.5] } }
    node Tree1 from @asset("d3a10007") { Transform3D { position = [14, 0, 3] } }
    node Tree2 from @asset("d3a10007") { Transform3D { position = [16, 0, 10]  scale = [1.3, 1.3, 1.3] } }
    node Tree3 from @asset("d3a10007") { Transform3D { position = [-16, 0, -4]  scale = [1.2, 1.4, 1.2] } }
    node Tree4 from @asset("d3a10007") { Transform3D { position = [-9, 0, -15] } }
    node Tree5 from @asset("d3a10007") { Transform3D { position = [6, 0, -17]  scale = [1.4, 1.2, 1.4] } }
    node Tree6 from @asset("d3a10007") { Transform3D { position = [-18, 0, 14]  scale = [0.9, 1.1, 0.9] } }
    node Tree7 from @asset("d3a10007") { Transform3D { position = [19, 0, -12]  scale = [1.1, 1.5, 1.1] } }
    node Crystal1 from @asset("d3a10008") { Transform3D { position = [-8, 0, 12] } }
    node Crystal2 from @asset("d3a10008") { Transform3D { position = [12, 0, 12]  rotation = [0, 40, 0]  scale = [1.3, 1.3, 1.3] } }
    node Crystal3 from @asset("d3a10008") { Transform3D { position = [-13, 0, -11]  rotation = [0, 80, 0] } }
    node Rock1 {
      Transform3D { position = [8, 0.3, 3]  rotation = [10, 30, 5]  scale = [1.4, 0.8, 1.1] }
      MeshRenderer3D { mesh = "sphere"  color = [125, 120, 125]  pattern = "noise"  shadow = true }
    }
    node Rock2 {
      Transform3D { position = [-7, 0.25, -2]  rotation = [-8, 70, 0]  scale = [1, 0.6, 1.3] }
      MeshRenderer3D { mesh = "sphere"  color = [115, 110, 118]  pattern = "noise"  shadow = true }
    }
    node Fireflies {
      Particles3D { preset = "fireflies"  box = [40, 3, 40] }
    }
    node Orbs {
      OrbSpawner { prefab = @asset("d3a10002")  count = 10  radius = 15 }
    }
    node Slime1 from @asset("d3a10003") { Transform3D { position = [9, 0, 8] } }
    node Slime2 from @asset("d3a10003") {
      Transform3D { position = [-10, 0, 4]  scale = [1.4, 1.4, 1.4] }
      node Body { MeshRenderer3D { color = [240, 120, 160]  emissive = [60, 10, 30] } }
    }
    node Drone1 from @asset("d3a10004") { Transform3D { position = [0, 2.4, 6] } }
    node Drone2 from @asset("d3a10004") {
      Transform3D { position = [-6, 3, -9] }
      DroneHover { radius = 5  speed = -0.4 }
    }
    node Golem from @asset("d3a10005") { Transform3D { position = [-14, 0, 0] } }
    node GoldRunner {
      Transform3D { }
      PathRunner { radius = 12.5  speed = 6.5 }
      SkinnedModel3D { model = @asset("a3d0f8b1")  speed = 1.35  color = [255, 215, 120]  emissive = [70, 45, 0]  rim = 0.6 }
      node Trail {
        Trail3D { offset = [0, 1.1, 0]  width = 0.5  duration = 0.5  color = [255, 210, 90, 200]  color_end = [255, 120, 30, 0] }
      }
    }
    node ShadowRunner {
      Transform3D { scale = [1.1, 1.1, 1.1] }
      PathRunner { radius = 9  speed = -5  phase = 3.1 }
      SkinnedModel3D { model = @asset("a3d0f8b1")  speed = 1.1  color = [90, 70, 130]  emissive = [40, 10, 80]  rim = 1.4 }
      node Aura {
        Transform3D { position = [0, 1, 0] }
        Particles3D { preset = "magic"  rate = 30  radius = 0.5  emit_shape = "sphere" }
      }
    }
    node Hero {
      Transform3D { }
      SkinnedModel3D { model = @asset("a3d0f8b1")  rim = 0.25 }
      HeroController { }
      Health { max = 8  team = "hero" }
      HeroCombat { }
      node Trail {
        Trail3D { offset = [0, 1, 0]  width = 0.6  duration = 0.35  emitting = false }
      }
      node Dust {
        Particles3D { preset = "dust" }
      }
      node Halo {
        Transform3D { position = [0, 0.06, 0]  scale = [1.5, 1.5, 1.5] }
        Spin3D { speed = [0, 60, 0] }
        MeshRenderer3D { mesh = "ring"  color = [120, 200, 255, 160]  blend = "additive"  unlit = true }
      }
    }
  }
  node HUD {
    Canvas { }
    node Score {
      position = [20, 16]
      Label { text = "Orbs: 0"  bind = "orbs"  bind_format = "Orbs: {}"  size = 30  shadow_color = [0, 0, 0, 160]  shadow_offset = [1, 2] }
      Widget { align_left = true  left = 20  align_top = true  top = 16 }
    }
    node HpLabel {
      position = [20, 58]
      Label { text = "HP"  size = 18  color = [255, 200, 200]  shadow_color = [0, 0, 0, 160]  shadow_offset = [1, 1] }
      Widget { align_left = true  left = 20  align_top = true  top = 58 }
    }
    node HpBar {
      position = [150, 68]
      UITransform { size = [220, 16] }
      ProgressBar { bind = "hp"  bind_max_key = "max_hp"  progress = 1  fill_color = [235, 70, 80, 255]  back_color = [0, 0, 0, 140]  radius = 6 }
      Widget { align_left = true  left = 50  align_top = true  top = 60 }
    }
    node Kills {
      position = [290, 16]
      Label { text = "Defeated: 0"  bind = "kills"  bind_format = "Defeated: {}"  size = 22  color = [255, 220, 160]  shadow_color = [0, 0, 0, 160]  shadow_offset = [1, 2] }
      Widget { align_left = true  left = 200  align_top = true  top = 22 }
    }
    node Stats {
      position = [20, 92]
      Label { text = ""  size = 16  color = [220, 230, 255, 220]  shadow_color = [0, 0, 0, 160]  shadow_offset = [1, 1] }
      Widget { align_left = true  left = 20  align_top = true  top = 92 }
      StatsLabel { }
    }
    node Help {
      position = [20, 526]
      Label { text = "WASD / arrows: run    J or click: slash    K: magic bolt    Shift / Space: dash    Q / E or drag: orbit camera    Esc: quit"  size = 18  color = [255, 255, 255, 230]  valign = "bottom"  shadow_color = [0, 0, 0, 160]  shadow_offset = [1, 2] }
      Widget { align_left = true  left = 20  align_bottom = true  bottom = 14 }
    }
  }
}
