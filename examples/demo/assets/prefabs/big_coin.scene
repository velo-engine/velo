# Prefab "variant": just a prefab whose root is `from` another prefab.
# Only writes what differs from coin.scene — edit coin.scene and big coins change too.
node BigCoin from @asset("d2c8f1a9") {                               # prefabs/coin.scene
  scale = [1.8, 1.8]
  Sprite { color = [255, 170, 120, 255] }
  SpriteAnimator { fps = 6 }
  Pickup { value = 5 }
}
