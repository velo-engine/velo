node Main {
  PhysicsWorld { gravity = [0, 0] }                                  # top-down: no gravity
  node Background {
    position = [480, 270]
    Sprite { texture = @asset("b8c1e2a3")  size = [960, 540] }
  }
  node Camera {                                                       # follows the player, stays inside the background
    position = [480, 270]
    Camera { zoom = 1.25  follow = "World/Player"  smoothing = 6  limit_max = [960, 540] }
  }
  node World {
    y_sort = true                                                     # lower on screen = in front (trees, player, crates)
    node Pond {                                                       # tiles painted in the editor (TileMap)
      position = [312, 66]
      TileMap { tileset = @asset("e71a0c3d")  columns = 7  rows = 3  tile_size = [48, 48]  tiles = [3, 0, 1, 1, 1, 2, 7, -1, 4, 5, 11, 5, 6, 3, 13, 8, 9, 9, 9, 10, -1] }
    }
    node Tree1 {
      position = [220.3085, 137.6868]
      rotation = 32
      Sprite { texture = @asset("7b2e44f1")  anchor = [0.5, 0.9]  size = [96, 120] }
      CircleCollider { radius = 12  offset = [0, -8] }                # trunk: static (no RigidBody)
    }
    node Tree2 {
      position = [276.5427, 381.5475]
      Sprite { texture = @asset("7b2e44f1")  anchor = [0.5, 0.9]  size = [80, 100] }
      CircleCollider { radius = 12  offset = [0, -8] }                # trunk: static (no RigidBody)
    }
    node Tree3 {
      position = [860, 150]
      Sprite { texture = @asset("7b2e44f1")  anchor = [0.5, 0.9]  size = [96, 120]  flip_x = true }
      CircleCollider { radius = 12  offset = [0, -8] }                # trunk: static (no RigidBody)
    }
    node Crates {
      position = [640, 190]
      node A {
        scale = [2.5, 2.5]
        Sprite { texture = @asset("3e7d5a10") }
        RigidBody { linear_damping = 8  angular_damping = 8 }         # pushable crates
        BoxCollider { size = [22, 22]  density = 2 }
      }
      node B {
        position = [62, 14]
        rotation = 12
        scale = [2.5, 2.5]
        Sprite { texture = @asset("3e7d5a10") }
        RigidBody { linear_damping = 8  angular_damping = 8 }         # pushable crates
        BoxCollider { size = [22, 22]  density = 2 }
      }
      node C {
        position = [30, -48]
        rotation = -6
        scale = [2, 2]
        Sprite { texture = @asset("3e7d5a10") }
        RigidBody { linear_damping = 8  angular_damping = 8 }         # pushable crates
        BoxCollider { size = [22, 22]  density = 2 }
      }
    }
    node CrateWall {                                                  # one tiled Sprite repeating the crate
      position = [430, 330]
      Sprite { texture = @asset("3e7d5a10")  size = [144, 36]  draw_mode = "tiled"  pixel_scale = 1.5 }
      BoxCollider { size = [144, 36] }
    }
    node Sign {                                                       # 9-slice: the frame keeps its thickness at any size
      position = [760, 300]
      Sprite { texture = @asset("9a51ce07")  size = [150, 56]  draw_mode = "sliced"  border_left = 8  border_top = 8  border_right = 8  border_bottom = 8  pixel_scale = 2 }
      node Text {
        Label { text = "Collect!"  size = 20  color = [70, 44, 26, 255]  align = "center"  valign = "middle" }
      }
    }
    node Coins {
      CoinSpawner { prefab = @asset("d2c8f1a9")  count = 10  area_min = [60, 90]  area_max = [900, 480] }
    }
    node BigCoin from @asset("6a5e3b90") {
      position = [820, 430]
    }
    node BigCoin2 from @asset("6a5e3b90") {
      position = [154.5617, 261.4367]
      Pickup { value = 10 }
    }
    node Fireflies {                                                  # looping particles from the scene file
      position = [480, 300]
      z_index = 1                                                     # over everything in the World
      ParticleSystem { rate = 6  lifetime = 3  lifetime_var = 1  speed = 12  speed_var = 8  spread = 180  shape = "box"  shape_size = [900, 460]  start_size = 5  end_size = 2  start_color = [255, 240, 140, 230]  end_color = [255, 220, 90, 0]  additive = true }
    }
    node Player from @asset("e4a1b7c2") {
      position = [482.663, 205.8465]
    }
  }
  node Audio from @asset("7a0d10a5") { }                             # persistent: the menu's music keeps playing
  node HUD {
    unscaled_time = true                                              # keeps running while paused (P)
    Canvas { }                                                        # screen space: the camera does not move it
    PauseControls { }
    node TopBar {                                                     # reaches the real screen edges, under a notch
      position = [480, 30]
      UITransform { size = [960, 60] }
      Widget { align_left = true  align_right = true  align_top = true  safe_area = false }
      Panel { color = [0, 0, 0, 90] }
    }
    node Score {                                                      # kept inside the safe area (the default)
      position = [20, 14]
      Label { text = "Coin: 0"  size = 32 }
      Widget { align_left = true  left = 20  align_top = true  top = 14 }
      ScoreBoard {  }
    }
    node Help {
      position = [20, 526]
      Label { text = "Arrows / WASD / joystick: move    R: more coins    P: pause    T: slow motion    M: menu    Esc: quit"  size = 18  color = [255, 255, 255, 210]  valign = "bottom" }
      Widget { align_left = true  left = 20  align_bottom = true  bottom = 14 }
    }
    node MoreCoins {
      position = [694.9319, 46.0538]
      UITransform { size = [160, 40] }
      Widget { align_right = true  right = 16  align_top = true  top = 14 }
      Panel { color = [70, 130, 220, 255]  radius = 8  border_width = 1 }
      Button {  }
      SpawnButton {  }
      node Text {
        Label { text = "More coins"  size = 18  align = "center"  valign = "middle" }
      }
    }
    node Log {
      position = [659.0886, 451.5474]
      UITransform { size = [180, 150] }
      Widget { align_right = true  right = 16  align_top = true  top = 66 }
      Panel { color = [0, 0, 0, 110]  radius = 6 }
      ScrollView {  }
      PickupLog {  }
      node Content {
        position = [-90, -75]
        UITransform { size = [180, 0]  anchor = [0, 0] }
        Layout { spacing = [4, 2]  padding = 6 }
      }
    }
    node Joystick {
      position = [140, 380]
      UITransform { size = [240, 240] }
      Widget { align_left = true  left = 16  align_bottom = true  bottom = 40 }
      Joystick { radius = 50 }
      node Base {
        UITransform { size = [120, 120] }
        Panel { color = [255, 255, 255, 40]  radius = 60  border_color = [255, 255, 255, 120]  border_width = 2 }
        node Knob {
          UITransform { size = [56, 56] }
          Panel { color = [255, 255, 255, 170]  radius = 28 }
        }
      }
    }
    node Paused {
      active = false                                                  # shown by PauseControls
      UITransform { size = [260, 70] }
      Widget { align_center_x = true  align_center_y = true }
      Panel { color = [0, 0, 0, 160]  radius = 10 }
      node Text { Label { text = "PAUSED"  size = 36  align = "center"  valign = "middle" } }
    }
    node Touches {
      TouchMarkers {  }
    }
  }
}
